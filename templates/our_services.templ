package templates

templ OurServices() {
	<section id="about" class="w-full px-40 py-20 md:py-28 bg-primary dark:bg-primary">
		<div class="container mx-auto max-w-6xl md:gap-14">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white">
					Our <span class="bg-gradient-to-r from-emerald-400 to-teal-500 bg-clip-text text-transparent">Services</span>
				</h2>
				<div class="mt-4 h-1 w-20 mx-auto rounded-full bg-gradient-to-r from-emerald-400 to-teal-500"></div>
			</div>
			<div class="col-span-3 lg:col-span-2 grid grid-cols-2 gap-4">
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/40 shadow-lg shadow-emerald-500/10 backdrop-blur-lg transition duration-300 hover:-translate-y-1">
					<div class="p-4">
						<div class="flex items-center gap-2 mb-2 text-emerald-500">
							<img src="static/assets/services/sc_audit.svg" class="w-14 h-14"/>
						</div>
						<p class="text-[1.25rem] mb-4 uppercase tracking-[0.1em] text-emerald-400 dark:text-emerald-500">Smart Contract Audit</p>
						<p class="text-xs font-semibold text-gray-800 dark:text-gray-600">
							End-to-end security for your blockchain projects.
							We go beyond standard checks like reentrancy and arithmetic flaws, delivering in-depth assessments that uncover vulnerabilities, logic bugs, and exploit paths. We also undergo economic attack vectors and complex DeFi interactions to make sure your smart contract is not vulnerable to these malicious interactions.
						</p>
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/40 shadow-lg shadow-emerald-500/10 backdrop-blur-lg transition duration-300 hover:-translate-y-1">
					<div class="p-4">
						<div class="flex items-center gap-2 mb-2 text-emerald-500 w-14 h-14">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
								<circle cx="12" cy="12" r="10"></circle>
								<circle cx="12" cy="12" r="6"></circle>
								<circle cx="12" cy="12" r="2"></circle>
							</svg>
						</div>
						<p class="text-[1.25rem] mb-4 uppercase tracking-[0.1em] text-emerald-400 dark:text-emerald-500">Penetration Testing</p>
						<p class="text-xs font-semibold text-gray-800 dark:text-gray-600">
							Realistic attack simulations to expose your weaknesses.
							Our penetration testing replicates real-world threat scenarios across networks, applications, and systems—identifying critical vulnerabilities, evaluating your detection and response capabilities, and revealing the areas most at risk.
						</p>
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/40 shadow-lg shadow-emerald-500/10 backdrop-blur-lg transition duration-300 hover:-translate-y-1">
					<div class="p-4">
						<div class="flex items-center gap-2 mb-2 text-emerald-500 w-14 h-14">
							<img src="static/assets/services/protocol_audit.svg" class="w-14 h-14"/>
						</div>
						<p class="text-[1.25rem] mb-4 uppercase tracking-[0.1em] text-emerald-400 dark:text-emerald-500">Protocol Audit</p>
						<p class="text-xs font-semibold text-gray-800 dark:text-gray-600">
							Secure foundations from the first block.
							Our in-depth audits for Polkadot and Substrate focus on protocol-level security—covering runtime logic, consensus design, cryptographic assumptions, economic models, and resilience against low-level attacks such as Denial of Service.
						</p>
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/40 shadow-lg shadow-emerald-500/10 backdrop-blur-lg transition duration-300 hover:-translate-y-1">
					<div class="p-4">
						<div class="flex items-center gap-2 mb-2 text-emerald-500 w-14 h-14">
							<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8M12 17v4"></path><circle cx="18" cy="7" r="2"></circle><path d="M18 9v2"></path></svg>
						</div>
						<p class="text-[1.25rem] mb-4 uppercase tracking-[0.1em] text-emerald-400 dark:text-emerald-500">Browser Extension</p>
						<p class="text-xs font-semibold text-gray-800 dark:text-gray-600">
							Deep-dive testing of Chrome, Firefox, and Brave extension wallets. We analyze manifest permissions, content script injection, message passing, and cross-origin risks.
						</p>
						<ul class="space-y-2 text-xs mt-4 text-gray-800 dark:text-gray-600">
							<li class="flex items-center gap-3">
								@BulletIcon()
								Content script isolation &amp; CSP bypass
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								Background service worker attacks
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								Extension fingerprinting &amp; spoofing
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								Phishing via DOM injection
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								Storage &amp; keyring extraction
							</li>
						</ul>
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/40 shadow-lg shadow-emerald-500/10 backdrop-blur-lg transition duration-300 hover:-translate-y-1">
					<div class="p-4">
						<div class="flex items-center gap-2 mb-2 text-emerald-500 w-14 h-14">
							<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8M12 17v4"></path><circle cx="18" cy="7" r="2"></circle><path d="M18 9v2"></path></svg>
						</div>
						<p class="text-[1.25rem] mb-4 uppercase tracking-[0.1em] text-emerald-400 dark:text-emerald-500">IOS Application</p>
						<p class="text-xs font-semibold text-gray-800 dark:text-gray-600">
							Full black, grey, and white-box assessments of iOS wallet apps. We cover Secure Enclave usage, biometric bypass, IPC, and runtime manipulation via Frida.
						</p>
						<ul class="space-y-2 text-xs mt-4 text-gray-800 dark:text-gray-600">
							<li class="flex items-center gap-3">
								@BulletIcon()
								Keychain data leakage analysis
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								Jailbreak detection bypass
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								SSL pinning circumvention
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								Binary patching &amp; hooking
							</li>
							<li class="flex gap-3">
								@BulletIcon()
								Sensitive data in memory dumps
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
}
