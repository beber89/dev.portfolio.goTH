package templates

templ SkillsSection() {
	<section id="skills" class="w-full px-6 py-20 md:py-28 bg-gray-200/70 dark:bg-gray-900/40">
		<div class="container mx-auto max-w-6xl">
			<div class="text-center mb-16">
				<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-400/40 bg-emerald-400/10 text-emerald-500 mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
						<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path>
					</svg>
					<span class="text-sm font-semibold tracking-wide">Technical Stack</span>
				</div>
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
					Skills &amp; <span class="bg-gradient-to-r from-emerald-400 to-teal-500 bg-clip-text text-transparent">Expertise</span>
				</h2>
				<div class="mt-4 h-1 w-20 mx-auto rounded-full bg-gradient-to-r from-emerald-400 to-teal-500"></div>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/50 backdrop-blur shadow-xl shadow-emerald-500/10 h-full">
					<div class="flex items-center gap-2 p-6 pb-4">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Blockchain</h3>
					</div>
					<div class="p-6 pt-0 space-y-4">
						@SkillRow("Daml", "Advanced", "advanced", "95%")
						@SkillRow("Canton Network", "Advanced", "advanced", "95%")
						@SkillRow("Avalanche", "Advanced", "advanced", "95%")
						@SkillRow("Ethereum", "Advanced", "advanced", "95%")
						@SkillRow("Hyperledger Fabric", "Advanced", "advanced", "95%")
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/50 backdrop-blur shadow-xl shadow-emerald-500/10 h-full">
					<div class="flex items-center gap-2 p-6 pb-4">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Smart Contracts</h3>
					</div>
					<div class="p-6 pt-0 space-y-4">
						@SkillRow("Daml Smart Contracts", "Advanced", "advanced", "95%")
						@SkillRow("Solidity", "Advanced", "advanced", "95%")
						@SkillRow("Chaincode (Go)", "Advanced", "advanced", "95%")
						@SkillRow("ERC Standards", "Advanced", "advanced", "95%")
						@SkillRow("Security Auditing", "Intermediate", "intermediate", "70%")
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/50 backdrop-blur shadow-xl shadow-emerald-500/10 h-full">
					<div class="flex items-center gap-2 p-6 pb-4">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Backend</h3>
					</div>
					<div class="p-6 pt-0 space-y-4">
						@SkillRow("Node.js", "Advanced", "advanced", "95%")
						@SkillRow("Python", "Advanced", "advanced", "95%")
						@SkillRow("PostgreSQL", "Advanced", "advanced", "95%")
						@SkillRow("MongoDB", "Advanced", "advanced", "95%")
						@SkillRow("Go", "Intermediate", "intermediate", "70%")
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/50 backdrop-blur shadow-xl shadow-emerald-500/10 h-full">
					<div class="flex items-center gap-2 p-6 pb-4">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Frontend</h3>
					</div>
					<div class="p-6 pt-0 space-y-4">
						@SkillRow("Next.js", "Advanced", "advanced", "95%")
						@SkillRow("React", "Advanced", "advanced", "95%")
						@SkillRow("Flutter", "Advanced", "advanced", "95%")
						@SkillRow("React Native", "Intermediate", "intermediate", "70%")
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/50 backdrop-blur shadow-xl shadow-emerald-500/10 h-full">
					<div class="flex items-center gap-2 p-6 pb-4">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">DevOps & Cloud</h3>
					</div>
					<div class="p-6 pt-0 space-y-4">
						@SkillRow("Docker", "Advanced", "advanced", "95%")
						@SkillRow("Kubernetes", "Intermediate", "intermediate", "70%")
						@SkillRow("GCP", "Intermediate", "intermediate", "70%")
						@SkillRow("CI/CD", "Intermediate", "intermediate", "70%")
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/50 backdrop-blur shadow-xl shadow-emerald-500/10 h-full">
					<div class="flex items-center gap-2 p-6 pb-4">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Monitoring & Observability</h3>
					</div>
					<div class="p-6 pt-0 space-y-4">
						@SkillRow("Grafana", "Advanced", "advanced", "95%")
						@SkillRow("Prometheus", "Advanced", "advanced", "95%")
						@SkillRow("Loki", "Advanced", "advanced", "95%")
						@SkillRow("OpenTelemetry SDKs", "Intermediate", "intermediate", "70%")
					</div>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/50 backdrop-blur shadow-xl shadow-emerald-500/10 h-full">
					<div class="flex items-center gap-2 p-6 pb-4">
						<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Data &amp; AI</h3>
					</div>
					<div class="p-6 pt-0 space-y-4">
						@SkillRow("Machine Learning", "Intermediate", "intermediate", "70%")
						@SkillRow("Data Analytics", "Intermediate", "intermediate", "70%")
						@SkillRow("Federated Learning", "Beginner", "beginner", "40%")
						@SkillRow("Big Data", "Beginner", "beginner", "40%")
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ SkillRow(name string, level string, variant string, percent string) {
	<div class="space-y-2">
		<div class="flex items-center justify-between">
			<span class="text-sm font-medium text-gray-900 dark:text-white">{ name }</span>
			@SkillBadge(level, variant)
		</div>
		<div class="h-1.5 bg-gray-200 dark:bg-gray-800 rounded-full overflow-hidden">
			<div class="h-full bg-gradient-to-r from-emerald-400 to-teal-500 rounded-full" style={ "width: " + percent }></div>
		</div>
	</div>
}

var badgeClass = "bg-emerald-500/10 text-emerald-300"

templ SkillBadge(level string, variant string) {
	switch variant {
		case "advanced":
			<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-emerald-500/15 text-emerald-400">{ level }</span>
		case "intermediate":
			<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-emerald-500 text-white">{ level }</span>
		case "beginner":
			<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-gray-200 text-gray-700 dark:bg-gray-800 dark:text-gray-200">{ level }</span>
		default:
	}
}
