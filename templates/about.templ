package templates

templ AboutSection() {
	<section id="about" class="w-full px-40 py-20 md:py-28 bg-gray-200 dark:bg-gray-950">
		<div class="container mx-auto max-w-6xl">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white">
					About <span class="bg-gradient-to-r from-emerald-400 to-teal-500 bg-clip-text text-transparent">Me</span>
				</h2>
				<div class="mt-4 h-1 w-20 mx-auto rounded-full bg-gradient-to-r from-emerald-400 to-teal-500"></div>
			</div>
			<div class="grid gap-10 md:grid-cols-5 md:gap-12">
				<div class="md:col-span-3">
					<p class="text-sm leading-relaxed text-gray-700 dark:text-gray-300">
						I am a blockchain engineer with more than seven years of experience delivering production-ready distributed systems. My expertise includes smart contract development in multiple languages, RWA tokenization, and full-stack Web3 architecture across public and permissioned blockchains. I work with organizations to bridge traditional finance and decentralized technology through scalable, enterprise-grade solutions.
					</p>
				</div>
				<div class="md:col-span-2 grid grid-cols-2 gap-4">
					<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/40 shadow-lg shadow-emerald-500/10 backdrop-blur-lg transition duration-300 hover:-translate-y-1">
						<div class="p-4">
							<div class="flex items-center gap-2 mb-2 text-emerald-500">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
									<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
									<circle cx="12" cy="10" r="3"></circle>
								</svg>
							</div>
							<p class="text-[0.65rem] mb-4 uppercase tracking-[0.3em] text-gray-500 dark:text-gray-400">Location</p>
							<p class="text-xs font-semibold text-gray-900 dark:text-white">Germany</p>
						</div>
					</div>
					<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/40 shadow-lg shadow-emerald-500/10 backdrop-blur-lg transition duration-300 hover:-translate-y-1">
						<div class="p-4">
							<div class="flex items-center gap-2 mb-2 text-emerald-500">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
									<circle cx="12" cy="12" r="10"></circle>
									<circle cx="12" cy="12" r="6"></circle>
									<circle cx="12" cy="12" r="2"></circle>
								</svg>
							</div>
							<p class="text-[0.65rem] mb-4 uppercase tracking-[0.3em] text-gray-500 dark:text-gray-400">Focus Areas</p>
							<p class="text-xs font-semibold text-gray-900 dark:text-white">DeFi · RWA · Enterprise</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
