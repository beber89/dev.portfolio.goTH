package templates

templ Navbar() {
	<nav class="w-full px-6 py-4 flex items-center justify-between bg-red-200 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800">
		<a href="/" class="flex items-center gap-2 text-emerald-400">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				attr:viewBox="0 0 40 40"
				width="62"
				height="42"
				fill="none"
			>
				<rect x="4" y="12" width="14" height="16" rx="2" stroke="currentColor" stroke-width="3"></rect>
				<rect x="14" y="2" width="14" height="16" rx="2" stroke="currentColor" stroke-width="3"></rect>
				<rect x="24" y="12" width="14" height="16" rx="2" stroke="currentColor" stroke-width="3"></rect>
				<rect x="34" y="2" width="14" height="16" rx="2" stroke="currentColor" stroke-width="3"></rect>
				<rect x="44" y="12" width="14" height="16" rx="2" stroke="currentColor" stroke-width="3"></rect>
			</svg>
		</a>
		<div class="flex items-center gap-1 text-xs font-semibold">
			<a href="#about" class="rounded-full px-4 py-2 transition-colors hover:bg-white/80 hover:text-gray-900 dark:hover:bg-white/10">About</a>
			<a href="#experience" class="rounded-full px-4 py-2 transition-colors hover:bg-white/80 hover:text-gray-900 dark:hover:bg-white/10">Experience</a>
			<a href="#highlights" class="rounded-full px-4 py-2 transition-colors hover:bg-white/80 hover:text-gray-900 dark:hover:bg-white/10">Highlights</a>
			<a href="#skills" class="rounded-full px-4 py-2 transition-colors hover:bg-white/80 hover:text-gray-900 dark:hover:bg-white/10">Skills</a>
			<a href="#credentials" class="rounded-full px-4 py-2 transition-colors hover:bg-white/80 hover:text-gray-900 dark:hover:bg-white/10">Credentials</a>
			<a href="#contact" class="rounded-full border border-gray-900/20 px-4 py-2 transition-colors hover:bg-gray-900 hover:text-white dark:border-white/30 dark:hover:bg-white dark:hover:text-gray-900">Contact</a>
		</div>
	</nav>
}
