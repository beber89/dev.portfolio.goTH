package templates

templ HighlightsSection() {
	<section id="highlights" class="w-full px-6 py-20 md:py-28 bg-gray-200 dark:bg-gray-950">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-14">
				<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-400/40 bg-emerald-400/10 text-emerald-500 mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
						<path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path>
					</svg>
					<span class="text-sm font-semibold tracking-wide">Portfolio</span>
				</div>
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
					Projects <span class="bg-gradient-to-r from-emerald-400 to-teal-500 bg-clip-text text-transparent">&amp; Highlights</span>
				</h2>
				<div class="mt-4 h-1 w-20 mx-auto rounded-full bg-gradient-to-r from-emerald-400 to-teal-500"></div>
			</div>
			<div class="w-full overflow-hidden py-4" id="trusted-grid">
				<div class="flex gap-6" data-trusted-track>
					<!-- original set -->
					<div class="flex-0 shrink-0 basis-[calc(25%-1.5rem)] flex items-center justify-center opacity-50 hover:opacity-100 transition">
						<img src="static/assets/projects/layerzero.svg" alt="LayerZero" class="max-w-full h-auto grayscale hover:grayscale-0"/>
					</div>
					<div class="flex-0 shrink-0 basis-[calc(25%-1.5rem)] flex items-center justify-center opacity-50 hover:opacity-100 transition">
						<img src="static/assets/projects/filecoin.svg" alt="Filecoin" class="max-w-full h-auto grayscale hover:grayscale-0"/>
					</div>
					<div class="flex-0 shrink-0 basis-[calc(25%-1.5rem)] flex items-center justify-center opacity-50 hover:opacity-100 transition">
						<img src="static/assets/projects/debridge.svg" alt="DeBridge" class="max-w-full h-auto grayscale hover:grayscale-0"/>
					</div>
					<div class="flex-0 shrink-0 basis-[calc(25%-1.5rem)] flex items-center justify-center opacity-50 hover:opacity-100 transition">
						<img src="static/assets/projects/sovryn.svg" alt="Sovryn" class="max-w-full h-auto grayscale hover:grayscale-0"/>
					</div>
					<div class="flex-0 shrink-0 basis-[calc(25%-1.5rem)] flex items-center justify-center opacity-50 hover:opacity-100 transition">
						<img src="static/assets/projects/sushiswap.svg" alt="SushiSwap" class="max-w-full h-auto grayscale hover:grayscale-0"/>
					</div>
					<div class="flex-0 shrink-0 basis-[calc(25%-1.5rem)] flex items-center justify-center opacity-50 hover:opacity-100 transition">
						<img src="static/assets/projects/almanak.png" alt="Almanak" class="max-w-full h-auto grayscale hover:grayscale-0"/>
					</div>
				</div>
			</div>
		</div>
		<section class="mt-10">
			<div class="rounded-2xl dark:border-gray-800 bg-primary dark:bg-primary/70 px-6 py-8 text-center shadow-sm shadow-emerald-500/5">
				<p class="text-xs uppercase tracking-[0.4em] text-gray-500 dark:text-gray-400">Audited TVL</p>
				<h3 class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white mt-3">
					$5<span class="bg-gradient-to-r from-emerald-400 to-teal-500 bg-clip-text text-transparent">B+</span>
				</h3>
				<p class="text-base text-gray-600 dark:text-gray-300 mt-2">
					Value secured across projects audited.
				</p>
			</div>
		</section>
	</section>
}
