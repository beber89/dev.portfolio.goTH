package templates

templ Hero(data HeroData) {
	<section class="w-full px-4 py-16 md:py-28 bg-gray-200 dark:bg-gray-950 scroll-mt-24" id="hero">
		<div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-10 md:gap-14">
			<!-- Photo placeholder -->
			<div class="w-36 h-36 sm:w-48 sm:h-48 md:w-64 md:h-64 rounded-full bg-gray-300 dark:bg-gray-700 flex-shrink-0 overflow-hidden mx-auto md:mx-0">
				<!-- Replace with <img src="/static/img/jose.jpg" alt="Jose Cruz" class="w-full h-full object-cover"/> -->
			</div>
			<!-- Text content -->
			<div class="text-center md:text-left space-y-4">
				<div class="text-center md:text-left space-y-4 px-2 md:px-0">
					<h2 class="text-3xl leading-tight md:leading-snug sm:text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white">{ data.Title }</h2>
					<p class="text-xs sm:text-sm font-semibold text-emerald-500 uppercase tracking-[0.3em]">
						{ data.Subtitle }
					</p>
					<p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl mx-auto md:mx-0">
						{ data.Body }
					</p>
					<div class="mt-6 flex flex-wrap justify-center md:justify-start gap-2 md:gap-3">
						<div class="inline-flex items-center rounded-xl md:justify-start border border-transparent bg-white/10 px-4 py-1.5 text-xs text-gray-900 shadow-sm ring-1 ring-gray-200 transition-colors hover:bg-white/30 dark:bg-white/5 dark:text-white dark:ring-white/20">
							Blockchain Engineer
						</div>
						<div class="inline-flex items-center rounded-xl md:justify-start border border-transparent bg-white/10 px-4 py-1.5 text-xs text-gray-900 shadow-sm ring-1 ring-gray-200 transition-colors hover:bg-white/30 dark:bg-white/5 dark:text-white dark:ring-white/20">
							Smart Contracts
						</div>
						<div class="inline-flex items-center rounded-xl md:justify-start border border-transparent bg-white/10 px-4 py-1.5 text-xs text-gray-900 shadow-sm ring-1 ring-gray-200 transition-colors hover:bg-white/30 dark:bg-white/5 dark:text-white dark:ring-white/20">
							Rust / Solidity
						</div>
						<div class="inline-flex items-center rounded-xl md:justify-start border border-transparent bg-white/10 px-4 py-1.5 text-xs text-gray-900 shadow-sm ring-1 ring-gray-200 transition-colors hover:bg-white/30 dark:bg-white/5 dark:text-white dark:ring-white/20">
							Security Audits
						</div>
					</div>
					<div class="flex flex-wrap justify-center md:justify-start items-center gap-6 md:gap-10 pt-4">
						<a
							href="https://www.linkedin.com/in/mahmoud-baibars/"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-emerald-500 hover:text-emerald-400 font-semibold transition-colors"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" attr:viewBox="0 0 24 24" fill="currentColor">
								<path
									d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85
              3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225
              0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
								></path>
							</svg>
						</a>
						<a
							href="https://www.github.com/beber89/"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-emerald-500 hover:text-emerald-400 font-semibold transition-colors"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" attr:viewBox="0 0 24 24" fill="currentColor">
								<path
									d="M12 .5C5.648.5.5 5.648.5 12a11.5 11.5 0 0 0 7.868 10.937c.575.107.786-.249.786-.556 0-.275-.01-1.004-.015-1.972-3.201.695-3.878-1.543-3.878-1.543-.524-1.333-1.28-1.689-1.28-1.689-1.046-.715.079-.701.079-.701 1.157.081 1.766 1.189 1.766 1.189 1.03 1.767 2.705 1.257 3.366.96.103-.748.403-1.258.733-1.547-2.554-.291-5.238-1.277-5.238-5.682 0-1.255.448-2.28 1.184-3.085-.119-.29-.513-1.461.112-3.046 0 0 .965-.309 3.165 1.178a10.914 10.914 0 0 1 5.76 0c2.2-1.487 3.164-1.178 3.164-1.178.626 1.585.232 2.756.114 3.046.738.805 1.182 1.83 1.182 3.085 0 4.417-2.688 5.388-5.254 5.673.414.356.783 1.056.783 2.129 0 1.536-.014 2.776-.014 3.154 0 .31.209.669.792.555A11.503 11.503 0 0 0 23.5 12C23.5 5.648 18.352.5 12 .5Z"
								></path>
							</svg>
						</a>
						<a
							href="https://www.github.com/beber89/"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-emerald-500 hover:text-emerald-400 font-semibold transition-colors"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								attr:viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect x="3" y="5" width="18" height="14" rx="2"></rect>
								<path d="M3.5 6.5 12 12.5 20.5 6.5"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
}
