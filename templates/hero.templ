package templates

templ Hero(data HeroData) {
	<section class="relative flex min-h-screen items-center justify-center w-full px-4 py-16 md:py-28 bg-primary dark:bg-primary scroll-mt-24" id="hero">
		<div class="z-10 max-w-5xl mx-auto gap-10 lg:gap-14 mt-24">
			<!-- Text content -->
			<div class="text-center space-y-4">
				<div class="text-center space-y-4 px-2 md:px-0">
					<h2 class="text-3xl leading-tight md:leading-snug sm:text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white">On a Mission to secure Web3</h2>
					<p class="text-xs sm:text-sm font-semibold text-emerald-500 uppercase tracking-[0.3em]">
						We guard what you build	
					</p>
					<p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl mx-auto">
						We safeguard your crypto projects so you can focus on innovating. We help you stay ahead, you focus on building the future while we handle the risks.
					</p>
				</div>
				<div class="pt-4">
					<a
						href="#contact"
						class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-6 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-emerald-500/40 transition hover:-translate-y-0.5 hover:bg-emerald-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300"
					>
						Get a Quote
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
							<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>
}
