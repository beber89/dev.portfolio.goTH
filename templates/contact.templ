package templates

templ ContactSection() {
	<section id="contact" class="w-full px-6 py-20 md:py-28 bg-primary/70 dark:bg-primary/30">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-16">
				<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-400/40 bg-emerald-400/10 text-emerald-500 mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
						<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
					</svg>
					<span class="text-sm font-semibold tracking-wide">Get in Touch</span>
				</div>
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
					Work <span class="bg-gradient-to-r from-emerald-400 to-teal-500 bg-clip-text text-transparent">Together</span>
				</h2>
				<p class="text-base text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
					Tell us about your story, secure your future in blockchain, we are excited to listen about your Web3 project
				</p>
				<div class="mt-4 h-1 w-20 mx-auto rounded-full bg-gradient-to-r from-emerald-400 to-teal-500"></div>
			</div>
			<div class="grid md:grid-cols-2 gap-6">
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/60 backdrop-blur shadow-xl shadow-emerald-500/10">
					<a href="mailto:mahmoudbaibars@gmail.com" class="flex items-center gap-4 p-6 group">
						<div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
								<rect width="20" height="16" x="2" y="4" rx="2"></rect>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
							</svg>
						</div>
						<div>
							<p class="text-sm text-gray-500 dark:text-gray-400">Email</p>
							<p class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-emerald-500 transition-colors">mahmoudbaibars@gmail.com</p>
						</div>
					</a>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/60 backdrop-blur shadow-xl shadow-emerald-500/10">
					<a href="https://www.linkedin.com/in/mahmoud-baibars/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-6 group">
						<div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
								<rect width="4" height="12" x="2" y="9"></rect>
								<circle cx="4" cy="4" r="2"></circle>
							</svg>
						</div>
						<div>
							<p class="text-sm text-gray-500 dark:text-gray-400">LinkedIn</p>
							<p class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-emerald-500 transition-colors">Connect with me</p>
						</div>
					</a>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/60 backdrop-blur shadow-xl shadow-emerald-500/10">
					<a href="https://calendly.com/ece-mahmoud" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-6 group">
						<div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
								<rect x="3" y="4" width="18" height="18" rx="2"></rect>
								<line x1="16" x2="16" y1="2" y2="6"></line>
								<line x1="8" x2="8" y1="2" y2="6"></line>
								<line x1="3" x2="21" y1="10" y2="10"></line>
							</svg>
						</div>
						<div>
							<p class="text-sm text-gray-500 dark:text-gray-400">Schedule</p>
							<p class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-emerald-500 transition-colors">Book a call</p>
						</div>
					</a>
				</div>
				<div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/60 backdrop-blur shadow-xl shadow-emerald-500/10">
					<a href="https://github.com/beber89" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-6 group">
						<div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77 5.44 5.44 0 0 0 3.5 8.5c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
							</svg>
						</div>
						<div>
							<p class="text-sm text-gray-500 dark:text-gray-400">GitHub</p>
							<p class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-emerald-500 transition-colors">Explore my work</p>
						</div>
					</a>
				</div>
			</div>
		</div>
	</section>
}
